// メモを JSON で出し入れする小さな API サーバー（std:router で経路を書く）
//   dolphin examples/todo_api.dol
//   curl localhost:8080/todos
//   curl -X POST localhost:8080/todos -d '{"title": "牛乳を買う"}'
//   curl -X DELETE localhost:8080/todos/1
@http := import["std:http"]
@json := import["std:json"]
@router := import["std:router"]

@todos := {:}
@next_id := 1

list_todos[@req] (
    @items := {}
    for @key in map_keys[@todos] (
        arr_push[@items, @todos{@key}]
    )
    # @router.json[200, @items]
)

add_todo[@req] (
    @data := @json.parse[@req{"body"}]
    if is_error[@data] (
        # @router.json[400, {"error": err_message[@data]}]
    )
    @todo := {"id": @next_id, "title": @data{"title"}}
    @todos{to_str[@next_id]} = @todo
    @next_id = @next_id + 1
    # @router.json[201, @todo]
)

remove_todo[@req] (
    @id := @req{"params"}{"id"}
    if !map_has[@todos, @id] (
        # @router.json[404, {"error": "not found"}]
    )
    map_remove[@todos, @id]
    # {"status": 204}
)

@app := @router.new[]
@router.get[@app, "/todos", list_todos]
@router.post[@app, "/todos", add_todo]
@router.delete[@app, "/todos/:id", remove_todo]
@router.not_found[@app, [@req] ( # @router.json[404, {"error": "no route"}] )]

log["http://127.0.0.1:8080 で待ち受けます"]
@result := @http.serve[8080, @router.handler[@app]]
log["サーバーを始められません:", err_message[@result]]
