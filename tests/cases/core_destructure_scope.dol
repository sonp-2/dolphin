// 分割代入の宣言: いま入っているスコープに作る
if true (
    {@a, @b} := {1, 2}
    log[@a, @b]
)

// 内側の宣言は外側を隠す
@a := "outer"
if true (
    {@a, @c} := {"inner", "c"}
    log[@a, @c]
)
log[@a]

// 代入: 宣言済みの最も内側の変数に入る
@x := 0
@y := 0
if true (
    @y := "shadowed"
    {@x, @y} = {10, 20}
    log[@x, @y]
)
log[@x, @y]

// ループの中の分割代入は、繰り返しごとに新しい変数
@fs := {}
for @row in {{1, 2}, {3, 4}} (
    {@l, @r} := @row
    arr_push[@fs, [] ( # @l * 10 + @r )]
)
log[@fs{0}[], @fs{1}[]]

// 関数の中で外の変数に代入する
@out1 := nil
@out2 := nil
fill[] (
    {@out1, @out2} = {"p", "q"}
)
fill[]
log[@out1, @out2]

// 右辺は左辺の変数を作る前に評価する
@z := {1, 2}
if true (
    {@z, @w} := @z
    log[@z, @w]
)
log[@z]

// 代入は右辺をすべて評価してから行う（入れ替え）
@m := 1
@n := 2
{@m, @n} = {@n, @m}
log[@m, @n]

// rest はコピーされた新しい配列
@src := {1, 2, 3}
{@h, ...@t} := @src
arr_push[@t, 99]
log[@src, @t]

// マップ
{"name": @val} := {"name": "dolphin", "age": 3}
log[@val]

// 分割代入した変数を捕まえる
make[@pair] (
    {@p, @q} := @pair
    # [] (
        @p = @p + 1
        # {@p, @q}
    )
)
@g := make[{5, 6}]
@g[]
log[@g[]]
