// for のループ変数に分割代入のパターン
@a := {"x", "y", "z"}
for {@i, @e} in arr_enumerate[@a] (
    log[@i, @e]
)
for {"name": @n, "age": @g} in {{"name": "A", "age": 3}, {"name": "B", "age": 4}} (
    log["@n:@g"]
)
for {@h, ...@t} in {{1, 2, 3}, {4}} (
    log[@h, @t]
)
// 入れ子のパターン
for {@p, {@q, @r}} in {{1, {2, 3}}, {4, {5, 6}}} (
    log[@p + @q + @r]
)
// 関数の中（スロットを使わない関数になる）でも、外の変数は読み書きできる
f[@xs] (
    @sum := 0
    for {@k, @v} in @xs (
        @sum = @sum + @k * @v
    )
    # @sum
)
log[f[{{1, 10}, {2, 20}}]]
