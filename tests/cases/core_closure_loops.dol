// ループ内で作ったクロージャは、繰り返しごとの変数を捕まえる
@fs := {}
for @n in {1, 2, 3} (
    @m := @n * 10
    arr_push[@fs, [] ( # @n + @m )]
)
log[arr_map[@fs, [@f] ( # @f[] )]]

// 捕まえた変数は繰り返しごとに別で、後からの書き換えが見える
@gs := {}
for @n in range[0, 3] (
    @c := 0
    arr_push[@gs, [] (
        @c = @c + @n
        # @c
    )]
)
log[@gs{0}[], @gs{1}[], @gs{1}[], @gs{2}[], @gs{2}[], @gs{2}[]]

// 同じ繰り返しで作った 2 つのクロージャは同じ変数を共有する
@pair := {}
for @n in {1} (
    @shared := 0
    arr_push[@pair, [] ( @shared = @shared + 1 )]
    arr_push[@pair, [] ( # @shared )]
)
@pair{0}[]
@pair{0}[]
log[@pair{1}[]]

// while の条件変数は外の変数なので、全部が同じ変数を見る
@hs := {}
@i := 0
while @i < 3 (
    arr_push[@hs, [] ( # @i )]
    @i = @i + 1
)
log[@hs{0}[], @hs{1}[], @hs{2}[]]

// 関数が、あとで宣言されたトップレベルの変数を読む
late[] ( # @later )
@later := "あとから"
log[late[]]

// 2 段上の変数を書き換える
outer[] (
    @x := 1
    @mid := [] (
        # [] (
            @x = @x + 1
            # @x
        )
    )
    @f := @mid[]
    @f[]
    @f[]
    # @x
)
log[outer[]]

// 関数の引数を捕まえる。呼び出しごとに別
mk[@base] ( # [@d] ( # @base + @d ) )
@m1 := mk[100]
@m2 := mk[200]
log[@m1[1], @m2[1], @m1[2]]

// 引数を書き換えるクロージャ
mk2[@v] (
    @inc := [] ( @v = @v + 1 )
    @inc[]
    @inc[]
    # @v
)
log[mk2[5], mk2[10]]
