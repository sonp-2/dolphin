// match: レコードのパターン。型名が同じレコードで、フィールドは定義順に当てる
record Point[@x, @y]
record Circle[@center, @radius]
record Rect[@w, @h]

area[@shape] (
    # match @shape (
        Circle[_, @r] => 3 * @r * @r
        Rect[@w, @h] => @w * @h
        Point[_, _] => 0
        _ => nil
    )
)

log[area[Circle[Point[0, 0], 2]]]
log[area[Rect[3, 4]]]
log[area[Point[1, 2]]]
log[area[{"w": 3, "h": 4}]]
log[area[5]]

// 入れ子と、フィールドへのリテラル・or
where[@shape] (
    # match @shape (
        Circle[Point[0, 0], _] => "原点の円"
        Circle[Point[@x, @y], _] => "円 @x,@y"
        Point[0, 0] => "原点"
        Point[0 | 1, @y] => "x は 0 か 1、y = @y"
        Point[@x, @y] if @x == @y => "斜め"
        _ => "その他"
    )
)
log[where[Circle[Point[0, 0], 1]]]
log[where[Circle[Point[2, 3], 1]]]
log[where[Point[0, 0]]]
log[where[Point[1, 9]]]
log[where[Point[5, 5]]]
log[where[Point[5, 6]]]

// 同じフィールドのレコードでも、型名が違えば合わない
record Vec2[@x, @y]
match Vec2[1, 2] (
    Point[@a, @b] => log["Point"]
    Vec2[@a, @b] => log["Vec2 @a @b"]
)

// フィールド数が違うレコードは合わない（定義のない名前でもエラーにならない）
match Rect[1, 2] (
    Unknown[@a, @b] => log["unknown"]
    _ => log["no match"]
)
