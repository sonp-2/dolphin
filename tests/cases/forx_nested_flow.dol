// 入れ子・break・continue
for {@i, @row} in arr_enumerate[{{1, 2, 3}, {4, 5, 6}, {7, 8, 9}}] (
    if @i == 2 (
        break
    )
    for @x in @row (
        if @x % 2 == 0 (
            continue
        )
        if @x > 4 (
            break
        )
        log[@i, @x]
    )
)
@m := {"a": 1, "b": 2, "c": 3, "d": 4}
for {@k, @v} in @m (
    if @v == 2 (
        continue
    )
    if @v == 4 (
        break
    )
    log[@k]
)
// 関数の中から # で抜ける
first_big[@xs] (
    for {@i, @x} in arr_enumerate[@xs] (
        if @x > 10 (
            # @i
        )
    )
    # -1
)
log[first_big[{1, 20, 30}], first_big[{1}]]
// 外側の変数と同名でも別
@k := "outer"
for {@k, @v} in {"a": 1} (
    log[@k]
)
log[@k]
