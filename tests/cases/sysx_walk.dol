@fs := import["std:fs"]
// fs.walk と fs.glob（design.md 5.49）。target/golden_sysx_walk の下だけを使う
@dir := "target/golden_sysx_walk"
@cleared := @fs.remove_all[@dir]
@fs.mkdir[@dir + "/src/sub"]
@fs.mkdir[@dir + "/.hidden"]
@fs.mkdir[@dir + "/empty"]
@fs.write[@dir + "/a.txt", "a"]
@fs.write[@dir + "/b.md", "b"]
@fs.write[@dir + "/src/main.dol", "m"]
@fs.write[@dir + "/src/lib.dol", "l"]
@fs.write[@dir + "/src/sub/deep.dol", "d"]
@fs.write[@dir + "/src/sub/note.txt", "n"]
@fs.write[@dir + "/.hidden/secret.txt", "s"]
@fs.write[@dir + "/.dot.txt", "x"]

// walk: ディレクトリはその中身より先。名前の文字コード順
log[@fs.walk[@dir]]
log[@fs.walk[@dir, {"files": false}]]
log[@fs.walk[@dir, {"dirs": false}]]
log[@fs.walk[@dir, {"max_depth": 1}]]
log[@fs.walk[@dir, {"max_depth": 2, "dirs": false}]]
log[@fs.walk[@dir, {"max_depth": 0}]]
log[@fs.walk[@dir + "/empty"]]
log[err_kind[@fs.walk[@dir + "/none"]]]
log[err_kind[@fs.walk[@dir + "/a.txt"]]]

// glob: base なしは、パターンの書いたとおりのパス
log[@fs.glob[@dir + "/*.txt"]]
log[@fs.glob[@dir + "/.*.txt"]]
log[@fs.glob[@dir + "/?.md"]]
log[@fs.glob[@dir + "/[ab].*"]]
log[@fs.glob[@dir + "/[!a].*"]]
log[@fs.glob[@dir + "/src/**/*.dol"]]
log[@fs.glob[@dir + "/src/*/"]]
log[@fs.glob[@dir + "/src/**"]]
log[@fs.glob[@dir + "/**/*.txt"]]
log[@fs.glob[@dir + "/src/main.dol"]]
log[@fs.glob[@dir + "/none/*"]]
// base あり: base からの相対パス
log[@fs.glob[@dir, "*.txt"]]
log[@fs.glob[@dir, "**/*.dol"]]
log[@fs.glob[@dir, "src/s*"]]
log[@fs.glob[@dir, "**/deep.*"]]

@fs.remove_all[@dir]
