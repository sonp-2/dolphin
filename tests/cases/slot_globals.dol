// ファイルの本体の変数: ブロックの変数とトップレベルの変数の解決
@x := "グローバル"
@n := 0

// ブロックの中の宣言より前の読みはトップレベル、あとはブロックの変数
if true (
    log[@x]
    @x := "ブロック"
    log[@x]
    @n = @n + 1
)
log[@x, @n]

// for の変数と本体の変数は繰り返しごとに別。外側の同名は隠れるだけ
@i := "外の i"
for @i in {1, 2} (
    @x := @i * 10
    @n = @n + @x
)
log[@i, @x, @n]

// 分割代入の宣言はブロックの変数、代入はトップレベル
@a := 1
if true (
    {@a, @b} := {10, 20}
    log[@a, @b]
    {@n} = {99}
)
log[@a, @n]

// 入れ子のブロックと while
@k := 0
while @k < 3 (
    @k = @k + 1
    if @k == 2 (
        @k := 100
        log[@k]
    )
)
log[@k]

// 関数からのトップレベル変数の読み書き
@count := 0
bump[] ( @count = @count + 1 )
bump[]
bump[]
log[@count]
