// str_format（design.md 5.48）
log[str_format["{} は {} 歳", "太郎", 20]]
log[str_format["{1}-{0}-{1}", "a", "b"]]
log[str_format["{{}} {{{}}}", 5]]
log[str_format["no fields"], str_format["余りの引数は無視", 1, 2]]
log[str_format["[{:>8}] [{:<8}] [{:^8}]", "ab", "ab", "ab"]]
log[str_format["[{:*^9}] [{:->6}] [{:_<4}]", "mid", 42, "x"]]
log[str_format["[{:6}] [{:6}]", 42, "ab"]]
log[str_format["{:.2f} {:.0f} {:f} {:8.3f}", 3.14159, 2.5, 1, -2.0]]
log[str_format["{:,} {:,} {:,.2f} {:,}", 1234567, 999, 1234567.891, -1234]]
log[str_format["{:05d} {:05d} {:3d}", 42, -42, 7]]
log[str_format["{:x} {:X} {:b} {:o} {:x}", 255, 255, 5, 8, -255]]
log[str_format["{:d} {:d} {:,}", 12i, 3.0, 1234567i]]
log[str_format["{:.3} {:s} {:s}", "abcdef", true, {1, 2}]]
log[str_format["{} {} {} {}", nil, true, 2.5, {1, "a"}]]
log[str_format["{:>6}|{:<6}|", 1.5, true]]
log[str_format["{:08.3f}", -3.14159]]
log[str_format["{2:>4}{0}{1}", "a", "b", "c"]]
