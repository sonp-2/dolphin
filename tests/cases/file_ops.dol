@fs := import["std:fs"]
// ファイルの操作（design.md 5.13）。target/golden_fs の下だけを使う
@dir := "target/golden_fs"
@left := @fs.remove_all[@dir]
log[is_error[@fs.list[@dir]], err_kind[@fs.list[@dir]]]

// ディレクトリを作る。途中も作り、すでにあれば何もしない
log[@fs.mkdir[@dir + "/a/b"], @fs.mkdir[@dir + "/a/b"]]
@fs.write[@dir + "/a/one.txt", "one"]
@fs.write[@dir + "/two.txt", "twotwo"]
@fs.write[@dir + "/Zed.txt", "z"]
log[@fs.list[@dir], @fs.list[@dir + "/a"], @fs.list[@dir + "/a/b"]]

// 情報
@info := @fs.info[@dir + "/two.txt"]
log[@info{"is_file"}, @info{"is_dir"}, @info{"size"}, type_of[@info{"modified"}], @info{"modified"} > 1000000000]
@dinfo := @fs.info[@dir + "/a"]
log[@dinfo{"is_file"}, @dinfo{"is_dir"}]
log[err_kind[@fs.info[@dir + "/none"]]]

// コピーと名前の変更。あれば置き換える
@fs.copy[@dir + "/two.txt", @dir + "/copy.txt"]
log[@fs.read[@dir + "/copy.txt"]]
@fs.write[@dir + "/copy.txt", "changed"]
@fs.copy[@dir + "/two.txt", @dir + "/copy.txt"]
log[@fs.read[@dir + "/copy.txt"]]
@fs.rename[@dir + "/copy.txt", @dir + "/a/moved.txt"]
log[@fs.exists[@dir + "/copy.txt"], @fs.read[@dir + "/a/moved.txt"]]
log[err_kind[@fs.rename[@dir + "/none", @dir + "/x"]], err_kind[@fs.copy[@dir + "/none", @dir + "/x"]]]
log[is_error[@fs.copy[@dir + "/a", @dir + "/x"]]]

// 消す。ディレクトリは、空でなければ fs.remove では消せない
log[err_kind[@fs.remove[@dir + "/none"]]]
log[is_error[@fs.remove[@dir + "/a"]]]
@fs.remove[@dir + "/a/moved.txt"]
@fs.remove[@dir + "/a/one.txt"]
@fs.remove[@dir + "/a/b"]
@fs.remove[@dir + "/a"]
log[@fs.list[@dir]]
@fs.remove[@dir + "/Zed.txt"]

// ディレクトリを中身ごと消す
@fs.mkdir[@dir + "/deep/er/still"]
@fs.write[@dir + "/deep/er/still/f.txt", "x"]
@fs.remove_all[@dir + "/deep"]
log[@fs.exists[@dir + "/deep"], @fs.list[@dir]]
@fs.remove_all[@dir]
log[@fs.exists[@dir], err_kind[@fs.remove_all[@dir]]]
