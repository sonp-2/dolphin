@fs := import["std:fs"]
// カレントディレクトリは cargo test のときパッケージのルート
@path := "target/golden_file_io.txt"
@fs.write[@path, "こんにちは\n"]
log[@fs.exists[@path]]
@fs.append[@path, "second line\n"]
@fs.append[@path, "third"]
log[@fs.read[@path]]

// 書き込むと中身は置き換わる
@fs.write[@path, "replaced"]
log[@fs.read[@path]]

// 行ごとに処理する
@fs.write[@path, "a,1\nb,2\nc,3"]
@total := 0
@lines := str_split[@fs.read[@path], "\n"]
@i := 0
while @i < arr_len[@lines] (
    @total = @total + to_num[str_split[@lines{@i}, ","]{1}]
    @i = @i + 1
)
log[@total]

log[@fs.exists["target/no_such_file.txt"], @fs.exists["target"]]
