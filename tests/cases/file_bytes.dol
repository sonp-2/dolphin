@fs := import["std:fs"]
// バイナリのファイル入出力（design.md 5.14）
@path := "target/golden_file_bytes.bin"
@data := bytes_from_arr[{0, 1, 2, 255, 254, 10, 13, 0}]
@fs.write_bytes[@path, @data]
@back := @fs.read_bytes[@path]
log[@back, @back == @data, @fs.info[@path]{"size"}]
@fs.append_bytes[@path, bytes_from_arr[{7, 7}]]
log[@fs.read_bytes[@path], bytes_len[@fs.read_bytes[@path]]]

// 文字列として読むと、UTF-8 ではないのでエラー値
log[err_kind[@fs.read[@path]]]

// 文字列のファイルは、バイト列としても読める
@fs.write[@path, "日本"]
log[@fs.read_bytes[@path], bytes_to_str[@fs.read_bytes[@path]]]
@fs.remove[@path]
log[err_kind[@fs.read_bytes[@path]]]
